{
  "name": "qel-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @qel/database db:generate",
    "db:migrate": "pnpm --filter @qel/database db:migrate",
    "db:push": "pnpm --filter @qel/database db:push",
    "db:studio": "pnpm --filter @qel/database db:studio",
    "backfill:voice": "tsx scripts/backfill_voice_archive.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4"
}
