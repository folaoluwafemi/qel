# ==============================================================================
# QEL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=qel-media-store
CLOUDFLARE_R2_PUBLIC_URL=

# Database Configuration (PostgreSQL on Railway / Neon / Oracle VM)
# When creating a PostgreSQL service in Railway, copy the "Database URL" here:
DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
HYPERDRIVE_DATABASE_URL=

# AI Model Provider Keys (Pluggable)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# App Security
JWT_SECRET=super_secret_jwt_key_change_in_production
